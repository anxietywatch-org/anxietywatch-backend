# ⚠️  NUNCA subas el archivo .env real a control de versiones
# Este archivo es solo un ejemplo. Copia este archivo a .env y rellena los valores reales.
# El archivo .env real debe estar en .gitignore

# ============================================
# Variables de entorno para desarrollo local
# ============================================

# Proveedor de persistencia: Mongo para usar MongoDB local
Persistence__Provider=Mongo

# MongoDB local (desarrollo)
# Usuario y contraseña para autenticación en MongoDB local
MONGO_USER=anxietywatch
MONGO_PASSWORD=anxietywatch_dev_password_change_me

# Connection string para MongoDB local
# Se construye automáticamente en docker-compose usando MONGO_USER y MONGO_PASSWORD
# Mongo__ConnectionString=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:27017/anxietywatch?authSource=admin

# Nombre de la base de datos
Mongo__DatabaseName=anxietywatch

# Clave de firma JWT (mínimo 32 caracteres / 256 bits)
# Genera una clave segura con: openssl rand -base64 32
Jwt__SigningKey=your-super-secret-jwt-signing-key-minimum-32-characters-long

# Entorno de ASP.NET Core (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development